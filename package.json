{
	"name": "stella",
	"private": true,
	"license": "Elastic-2.0",
	"version": "0.1.12",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "vite build",
		"start": "bun ./build/index.js",
		"deploy": "./deploy.sh",
		"preview": "bunx --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "bun test src",
		"test:watch": "bun test src --watch",
		"test:e2e": "./e2e/run.sh",
		"e2e:server": "rm -rf ./data/e2e && vite build && NODE_ENV=production PORT=${E2E_PORT:-4173} HOST=127.0.0.1 ORIGIN=http://127.0.0.1:${E2E_PORT:-4173} STELLA_URL=http://127.0.0.1:${E2E_PORT:-4173} DATABASE_PATH=./data/e2e/stella.db MEDIA_DIR=./data/e2e/media SESSION_SECRET=e2e-test-secret-0123456789abcdef0123456789 SEED_DEMO=true BODY_SIZE_LIMIT=25M IMMICH_DEMO=true NEXTCLOUD_DEMO=true UPDATE_CHECK=true UPDATE_FEED_URL=http://127.0.0.1:${E2E_FEED_PORT:-4174}/latest AUTH_OIDC_ENABLED=true OIDC_ISSUER=http://127.0.0.1:${E2E_OIDC_PORT:-4175} OIDC_CLIENT_ID=stella-e2e OIDC_CLIENT_SECRET=e2e-oidc-secret OIDC_ALLOWED_GROUPS=stella-users bun ./build/index.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@fontsource-variable/instrument-sans": "5.3.0",
		"@fontsource-variable/newsreader": "5.3.0",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-node": "6.0.5",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/bun": "1.4.5",
		"@types/cytoscape": "3.31.0",
		"drizzle-kit": "0.31.11",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8"
	},
	"dependencies": {
		"@lucide/svelte": "1.77.0",
		"cytoscape": "3.35.0",
		"drizzle-orm": "0.45.4",
		"jose": "6.2.18",
		"markdown-it": "15.0.3",
		"ulid": "3.0.2",
		"valibot": "1.5.0"
	}
}
