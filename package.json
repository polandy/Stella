		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/vite": "4.3.2",
		"@types/bun": "1.3.14",
		"drizzle-kit": "0.31.10",
		"svelte": "5.56.4",
		"svelte-check": "4.7.2",
		"tailwindcss": "4.3.2",
		"typescript": "6.0.3",
		"vite": "8.1.4"
	},
	"dependencies": {
		"drizzle-orm": "0.45.2",
