{
	"name": "stella",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "bun ./build/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
