{
	"name": "stella",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "bun ./build/index.js",
		"deploy": "./deploy.sh",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test src",
		"test:watch": "bun test src --watch",
		"test:e2e": "./e2e/run.sh",
		"e2e:server": "rm -rf ./data/e2e && vite build && NODE_ENV=production PORT=4173 HOST=127.0.0.1 ORIGIN=http://127.0.0.1:4173 STELLA_URL=http://127.0.0.1:4173 DATABASE_PATH=./data/e2e/stella.db MEDIA_DIR=./data/e2e/media SESSION_SECRET=e2e-insecure-secret SEED_DEMO=true bun ./build/index.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.69.2",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/vite": "4.3.2",
		"@types/bun": "1.3.14",
		"@types/cytoscape": "3.31.0",
		"@types/markdown-it": "14.1.2",
		"drizzle-kit": "0.31.10",
		"svelte": "5.56.4",
		"svelte-check": "4.7.2",
		"tailwindcss": "4.3.2",
		"typescript": "6.0.3",
		"vite": "8.1.4"
	},
	"dependencies": {
		"cytoscape": "3.34.0",
		"drizzle-orm": "0.45.2",
		"jose": "6.2.3",
		"markdown-it": "14.3.0",
		"ulid": "3.0.2",
		"valibot": "1.4.2"
	}
}
