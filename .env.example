# Stella configuration — copy to `.env` and adjust. See docs/07-deployment.md.

# --- Core ---
STELLA_URL=http://localhost:5173
DATABASE_PATH=./data/stella.db
MEDIA_DIR=./data/media
SESSION_SECRET=dev-insecure-secret-change-me   # prod: `openssl rand -hex 32`
# TZ=Europe/Zurich
# BODY_SIZE_LIMIT=25M   # request cap for uploads (Monica dump, photos); the Docker image sets it

# --- Auth toggles ---
AUTH_LOCAL_ENABLED=true
AUTH_OIDC_ENABLED=false

# --- Test phase ---
# Populate the database with the Brunner demo dataset on startup. Idempotent, so it is safe
# to leave on while testing. On a fresh database it also creates a break-glass admin
# (demo@stella.local / stella-demo-1234). Turn OFF before real use.
SEED_DEMO=false

# --- OIDC / Authelia (only needed when AUTH_OIDC_ENABLED=true) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=stella
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email groups
OIDC_PROVIDER_NAME=authelia

# --- OIDC authorization & mapping ---
OIDC_ALLOWED_GROUPS=stella-users
OIDC_ADMIN_GROUPS=stella-admins
OIDC_ALLOWED_EMAILS=
OIDC_JIT_PROVISION=true
OIDC_LINK_BY_EMAIL=true
OIDC_SYNC_ROLES=true
OIDC_SYNC_PROFILE=true
OIDC_RP_LOGOUT=true
